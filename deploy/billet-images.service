# One refresh of the guest images this node boots.
#
# THE OTHER HALF OF AN UPDATE. A billet release is a binary; the runner a job
# actually runs in is a guest image billet builds weekly, from the release the
# stable channel names, at whatever actions/runner GitHub has published — and
# GitHub stops queueing jobs to a runner about thirty days after a newer one
# ships. A deployment that updated its binary and never its image would be
# refused work with every surface reading healthy.
#
# WHAT IT DOES is `billet images refresh`: it reads the signed image channel and
# pulls, boot-verifies and promotes a generation only when the channel names an
# image newer than the newest one already imported; then it reaps generations
# nothing needs, keeping three verified ones per guest contract. On a node whose
# provider has no images to refresh it exits saying so; with
# `release: {automatic: false}` in billet.yaml it exits saying that.
#
# ENABLED BY THE PACKAGE, for the reason billet-upgrade.timer is: it connects
# nothing to GitHub and acts on nothing an operator has not configured.
#
#   systemctl disable --now billet-images.timer
[Unit]
Description=billet guest image refresh
Documentation=https://billet.readthedocs.io/en/latest/operating/guest-images.html
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# ROOT, BECAUSE THE PULL IS. It maps an RBD device to import into the cluster,
# installs the paired kernel under /var/lib/billet/kernels, and boots a
# Firecracker probe to verify the result — the same things the node does, as the
# same account.
User=root
Group=root
UMask=0077

ExecStart=/usr/bin/billet images refresh --config /etc/billet/billet.yaml

# A pull downloads about two gigabytes, decompresses fifteen, imports them into
# Ceph and boots a guest to prove them. Generous, and still a bound: a refresh
# that has taken three hours is stuck rather than slow.
TimeoutStartSec=10800
