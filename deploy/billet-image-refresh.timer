[Unit]
Description=billet: keep the guest image inside GitHub's 30-day runner window
Documentation=https://github.com/junioryono/billet

[Timer]
# WEEKLY, AGAINST A 30-DAY DEADLINE THAT NOTHING ELSE CAN SAVE US FROM.
#
# An ordinary self-hosted runner updates itself in place, so a stale image costs a
# download and keeps working. billet's cannot: a JIT configuration from GitHub's REST
# API carries DisableUpdate = True, measured, with no parameter to ask otherwise. The
# runner in the image is the runner forever, and rebuilding is the only way past the
# deadline -- which makes this timer load-bearing rather than housekeeping.
#
# The margin is the point. GitHub stops
# queueing jobs to a runner 30 days after a release it has not taken up, so a monthly
# schedule leaves no room for the run that fails -- and this run CAN fail, on a
# package mirror, on a verification, on a full disk. Weekly means four chances inside
# every window, and a rebuild that changes nothing is cheap.
OnCalendar=Sun 03:00
# SO A MACHINE THAT WAS OFF STILL CATCHES UP. A node rebooted on Sunday morning would
# otherwise skip a whole week, and the deadline does not skip with it.
Persistent=true
# SPREAD, because a fleet that all rebuilds at 03:00 hits the archive and the cluster
# together.
#
# THE SPREAD IS A COURTESY, NOT THE SAFETY, and two nodes are prevented from
# colliding twice over: whichever starts second asks whether a recent generation
# already exists and stands down, and if two genuinely overlap, an `rbd lock` taken in
# the cluster stops the writes interleaving.
#
# ENABLE THIS ON EVERY NODE. A timer on one machine stops when that machine does, and
# GitHub's thirty days do not pause while it is down. Every node carrying it means the
# rebuild happens as long as ANY node is up; the freshness check means it happens
# once.
RandomizedDelaySec=2h

[Install]
WantedBy=timers.target
