# When billet-images.service runs.
#
# DAILY, against an image that is built weekly: a day is the longest a published
# image waits to reach a node, and short beside the thirty-day window GitHub
# gives a runner release.
#
#   systemctl disable --now billet-images.timer
[Unit]
Description=billet guest image refresh, daily
Documentation=https://billet.readthedocs.io/en/latest/operating/guest-images.html

[Timer]
OnCalendar=daily

# SPREAD, because a fleet of nodes all pulling the same two gigabytes at
# 00:00:00 is a fleet of simultaneous downloads and simultaneous Ceph imports.
RandomizedDelaySec=1h

# A MISSED RUN IS RUN. A node that was off overnight would otherwise silently
# skip a day, and the failure an image refresh has is always the one nobody saw.
Persistent=true

Unit=billet-images.service

[Install]
WantedBy=timers.target
