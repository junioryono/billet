{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BilletRuntimeRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletRuntimeLaunch",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletRuntimeTag",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSnapshot",
            "CreateImage"
          ]
        },
        "StringLike": {
          "aws:RequestTag/sh.billet.owner": [
            "0f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "billet-ami-build-*"
          ]
        },
        "StringLikeIfExists": {
          "aws:RequestTag/sh.billet.cache-owner": [
            "0f1e2d3c4b5a69788796a5b4c3d2e1f0/*"
          ]
        }
      }
    },
    {
      "Sid": "BilletRuntimeTerminate",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheCreateVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheCloneSource",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume"
      ],
      "Resource": [
        "arn:aws:ec2:*::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheSnapshotSource",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheSnapshotCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheDescribe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletCacheAttach",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.cache-owner": "false"
        },
        "StringEquals": {
          "aws:ResourceTag/sh.billet.owner": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      }
    },
    {
      "Sid": "BilletCacheObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::billet-cache-example/production/*"
      ]
    },
    {
      "Sid": "BilletCacheList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::billet-cache-example"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "production/*"
          ]
        }
      }
    },
    {
      "Sid": "BilletCacheKMSUse",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncrypt*",
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:us-west-2:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ec2.us-west-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "BilletCacheKMSGrant",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:kms:us-west-2:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab"
      ],
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "BilletSpotInterruptions",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:us-west-2:123456789012:billet-spot-interruptions"
      ]
    },
    {
      "Sid": "BilletAMIBuilderSource",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateImage"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/sh.billet.owner": [
            "billet-ami-build-*"
          ]
        }
      }
    },
    {
      "Sid": "BilletAMIBuilderImage",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateImage"
      ],
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:*:snapshot/*"
      ]
    },
    {
      "Sid": "BilletAMIBuilderTerminate",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/sh.billet.owner": [
            "billet-ami-build-*"
          ]
        }
      }
    },
    {
      "Sid": "BilletAMIBuilderConsole",
      "Effect": "Allow",
      "Action": [
        "ec2:GetConsoleOutput"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/sh.billet.owner": [
            "billet-ami-build-*"
          ]
        }
      }
    },
    {
      "Sid": "BilletAMIBuilderPromote",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:*::image/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/sh.billet.owner": [
            "billet-ami-build-*"
          ]
        }
      }
    },
    {
      "Sid": "BilletPassRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/billet-node"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
