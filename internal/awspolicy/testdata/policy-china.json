{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BilletRuntimeRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletRuntimeLaunch",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletRuntimeDenyForeignSnapshot",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws-cn:ec2:*:*:snapshot/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "true"
        }
      }
    },
    {
      "Sid": "BilletRuntimeTag",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSnapshot"
          ]
        }
      }
    },
    {
      "Sid": "BilletRuntimeTerminate",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheCreateVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "aws:RequestTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheCloneSource",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume"
      ],
      "Resource": [
        "arn:aws-cn:ec2:*::snapshot/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheSnapshotSource",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot"
      ],
      "Resource": [
        "arn:aws-cn:ec2:*:*:volume/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheSnapshotCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot"
      ],
      "Resource": [
        "arn:aws-cn:ec2:*:*:snapshot/*"
      ],
      "Condition": {
        "Null": {
          "aws:RequestTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheDescribe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletCacheAttach",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.cache-owner": "false",
          "aws:ResourceTag/sh.billet.owner": "false"
        }
      }
    },
    {
      "Sid": "BilletCacheObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws-cn:s3:::billet-cache-cn/production/*"
      ]
    },
    {
      "Sid": "BilletCacheList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws-cn:s3:::billet-cache-cn"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "production/*"
          ]
        }
      }
    },
    {
      "Sid": "BilletCacheKMSUse",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncrypt*",
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws-cn:kms:cn-north-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ec2.cn-north-1.amazonaws.com.cn"
        }
      }
    },
    {
      "Sid": "BilletCacheKMSGrant",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws-cn:kms:cn-north-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab"
      ],
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "BilletSpotInterruptions",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws-cn:sqs:cn-north-1:123456789012:billet-spot"
      ]
    },
    {
      "Sid": "BilletPassRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws-cn:iam::123456789012:role/billet-node"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com.cn"
        }
      }
    }
  ]
}
