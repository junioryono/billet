<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{.Policy}}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Page.Title}}</title>
<style>{{.Style}}</style>
</head>
<body>
{{- with .Page}}
<header>
<p class="kicker">billet job</p>
<h1>{{.Heading}}</h1>
<p class="result {{.ResultClass}}">{{.Result}}</p>
<dl class="fields">
{{- range .Identity}}
<dt>{{.Label}}</dt><dd>{{.Value}}</dd>
{{- end}}
</dl>
</header>

<section id="steps">
<h2>Steps</h2>
{{- if .Steps.Why}}
<p class="why">{{.Steps.Why}}</p>
{{- else}}
<p>{{.Steps.Head}}</p>
<p class="note">{{.Steps.Alignment}}</p>
<ol class="timeline">
{{- range .Steps.Rows}}
<li class="{{.Class}}">
{{- if .Focus}}<button type="button" data-from="{{.From}}" data-to="{{.To}}" data-key="{{.Key}}" data-step="{{.Number}}" aria-pressed="false">
{{- else}}<button type="button" disabled>{{end -}}
<span class="n">{{.Number}}</span> <span class="name">{{.Name}}</span></button>
<span class="outcome">{{.Outcome}}</span>
<span class="took">{{.Took}}</span>
<svg class="bar" viewBox="0 0 1000 10" preserveAspectRatio="none" aria-hidden="true">
{{- if .HasBar}}<rect x="{{.BarX}}" y="0" width="{{.BarW}}" height="10"></rect>{{end -}}
</svg>
</li>
{{- end}}
</ol>
{{- end}}
</section>

<section id="charts">
<h2>Usage over the job</h2>
{{- with .Charts}}
{{- if .Why}}
<p class="why">{{.Why}}</p>
{{- else}}
<p>The host's series from {{.Start}} to {{.End}} on its own clock ({{.Length}}). {{- if .Focusable}} <span id="focus">Showing the whole series.</span> <button type="button" id="whole" data-from="0" data-to="{{.Units}}" data-origin="{{.Origin}}" data-width="{{.Width}}">Show the whole series</button>{{end}}</p>
<p class="note">{{.Drawn}}{{if .Focusable}} Choosing a step focuses every chart on its window; the vertical scale stays the whole series'.{{end}}</p>
{{- $c := .}}
{{- with .Gaps}}
<figure class="chart">
<figcaption>Not seen by the sampler</figcaption>
<div class="plot strip">
<svg data-chart="" viewBox="0 0 {{$c.Units}} 100" preserveAspectRatio="none" role="img" aria-label="Intervals the sampler did not see">
<path class="gap" d="{{.}}"></path>
</svg>
<span class="x0">{{$c.X0}}</span><span class="x1">{{$c.X1}}</span>
</div>
<p class="note">Each mark is an interval the sampler did not see, listed with its cause under What the host measured; every chart's lines break there, and no step's usage counts it.</p>
</figure>
{{- end}}
{{- range .Charts}}
<figure class="chart">
<figcaption>{{.Title}}
{{- if not .Unmeasured}}{{range .Lines}} <span class="key {{.Class}}">{{.Label}}</span>{{end}}{{end -}}
</figcaption>
{{- if .Unmeasured}}
<p class="unmeasured">{{.Unmeasured}}</p>
{{- else}}
<div class="plot">
<span class="top">{{.Top}}</span>
<svg data-chart="" viewBox="0 0 {{$c.Units}} 100" preserveAspectRatio="none" role="img" aria-label="{{.Title}}">
{{- range $c.Bands}}
<rect class="{{.Class}}" data-key="{{.Key}}" x="{{.X}}" y="0" width="{{.W}}" height="100"></rect>
{{- end}}
{{- with .Limit}}
<line class="limit" x1="0" x2="{{$c.Units}}" y1="{{.Y}}" y2="{{.Y}}"></line>
{{- end}}
{{- range .Lines}}
<path class="line {{.Class}}" d="{{.D}}"></path>
{{- end}}
</svg>
<span class="x0">{{$c.X0}}</span><span class="x1">{{$c.X1}}</span>
</div>
{{- with .Limit}}
<p class="note">Dashed: {{.Label}}.</p>
{{- end}}
{{- with .Note}}
<p class="note">{{.}}</p>
{{- end}}
{{- end}}
</figure>
{{- end}}
{{- end}}
{{- end}}
</section>

<section id="step-usage">
<h2>Usage by step</h2>
{{- if .Steps.Why}}
<p class="why">{{.Steps.Why}}</p>
{{- else if not .Steps.Rows}}
<p class="why">GitHub lists no steps for this job.</p>
{{- else}}
<div class="scroll">
<table>
<thead><tr><th>Step</th><th>Started (GitHub)</th><th>Took</th><th>CPU</th><th>Peak memory</th><th>Disk read</th><th>Disk written</th><th>Received</th><th>Sent</th><th>Energy</th></tr></thead>
<tbody>
{{- range .Steps.Rows}}
<tr><th scope="row">{{.Number}} {{.Name}}</th><td>{{with .Started}}{{.}}{{else}}not given{{end}}</td><td>{{.Took}}</td>
{{- if .Usage}}{{range .Usage}}<td{{if .Unmeasured}} class="unmeasured"{{end}}>{{.Value}}</td>{{end}}
{{- else}}<td colspan="7" class="none">{{.Note}}</td>{{end}}</tr>
{{- if and .Usage .Note}}
<tr class="qualifier"><td></td><td colspan="9">{{.Note}}</td></tr>
{{- end}}
{{- end}}
</tbody>
</table>
</div>
<p class="note">Network columns are the guest's own view. Disk is host IO that missed the host's page cache, plus writeback.</p>
{{- end}}
</section>

<section id="usage">
<h2>What the host measured</h2>
<p>{{.Usage.Report}}</p>
{{- with .Usage.Series}}
<p>The series: {{.}}.</p>
{{- end}}
{{- if .Usage.SeriesGaps}}
<ul class="gaps">
{{- range .Usage.SeriesGaps}}
<li>{{.}}</li>
{{- end}}
{{- with .Usage.SeriesMore}}
<li>{{.}}</li>
{{- end}}
</ul>
{{- end}}
{{- if .Usage.Groups}}
<dl class="fields">
{{- range .Usage.Groups}}
<dt>{{.Label}}</dt><dd{{if .Unmeasured}} class="unmeasured"{{end}}>{{.Value}}</dd>
{{- end}}
</dl>
<h3>Hardware counters</h3>
<dl class="fields">
{{- range .Usage.Counters}}
<dt>{{.Label}}</dt><dd{{if .Unmeasured}} class="unmeasured"{{end}}>{{.Value}}</dd>
{{- end}}
</dl>
{{- end}}
</section>

<section id="destinations">
<h2>Destinations</h2>
{{- with .Destinations}}
{{- if .Why}}
<p class="why">{{.Why}}</p>
{{- else}}
<p>{{.Summary}}</p>
{{- if .Rows}}
{{- $counted := .Counted}}
<div class="scroll">
<table>
<thead><tr><th>Address</th><th>Sent</th><th>Received</th><th>Connections</th>{{if $counted}}<th>Unanswered</th>{{end}}</tr></thead>
<tbody>
{{- range .Rows}}
<tr><th scope="row">{{.Addr}}</th><td>{{.Sent}}</td><td>{{.Received}}</td><td>{{.Connections}}</td>{{if $counted}}<td>{{.Unanswered}}</td>{{end}}</tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}
{{- with .More}}
<p>{{.}}</p>
{{- end}}
<dl class="fields">
<dt>other</dt><dd>{{.Other}}</dd>
<dt>unanswered</dt><dd>{{.Unanswered}}</dd>
<dt>complete</dt><dd>{{.Complete}}</dd>
<dt>tap</dt><dd>{{.Tap}}</dd>
</dl>
{{- with .TapNote}}
<p class="note">{{.}}</p>
{{- end}}
{{- end}}
{{- end}}
</section>

<section id="guest">
<h2>What the job's own VM reported</h2>
{{- $charts := .Charts}}
{{- with .Guest}}
{{- with .Banner}}
<p class="unverified">{{.}}</p>
{{- end}}
<p class="why">{{.Why}}</p>
{{- if .Channel}}
<h3>The channel, as the node counted it</h3>
<dl class="fields">
{{- range .Channel}}
<dt>{{.Label}}</dt><dd>{{.Value}}</dd>
{{- end}}
</dl>
{{- end}}
{{- if .HasReport}}
<h3>The report</h3>
<dl class="fields">
{{- range .Account}}
<dt>{{.Label}}</dt><dd>{{.Value}}</dd>
{{- end}}
<dt>skew</dt><dd>{{.Skew}}</dd>
</dl>
<h3>Memory</h3>
<dl class="fields">
{{- range .Memory}}
<dt>{{.Label}}</dt><dd{{if .Unmeasured}} class="unmeasured"{{end}}>{{.Value}}</dd>
{{- end}}
</dl>
{{- with .Chart}}
{{- if .Why}}
<p class="why">{{.Why}}</p>
{{- else}}
{{- with .Chart}}
<figure class="chart">
<figcaption>{{.Title}}{{range .Lines}} <span class="key {{.Class}}">{{.Label}}</span>{{end}}</figcaption>
<div class="plot">
<span class="top">{{.Top}}</span>
<svg data-chart="" viewBox="0 0 {{$charts.Units}} 100" preserveAspectRatio="none" role="img" aria-label="{{.Title}}">
{{- range $charts.Bands}}
<rect class="{{.Class}}" data-key="{{.Key}}" x="{{.X}}" y="0" width="{{.W}}" height="100"></rect>
{{- end}}
{{- with .Limit}}
<line class="limit" x1="0" x2="{{$charts.Units}}" y1="{{.Y}}" y2="{{.Y}}"></line>
{{- end}}
{{- range .Lines}}
<path class="line {{.Class}}" d="{{.D}}"></path>
{{- end}}
</svg>
<span class="x0">{{$charts.X0}}</span><span class="x1">{{$charts.X1}}</span>
</div>
{{- with .Limit}}
<p class="note">Dashed: {{.Label}}.</p>
{{- end}}
<p class="note">{{.Note}}</p>
</figure>
{{- end}}
{{- end}}
{{- end}}
<h3>Cross-checks against the host</h3>
<dl class="fields">
{{- range .Checks}}
<dt>{{.Label}}</dt><dd{{if .Unmeasured}} class="unmeasured"{{end}}>{{.Value}}</dd>
{{- end}}
{{- range .Agent}}
<dt>{{.Label}}</dt><dd>{{.Value}}</dd>
{{- end}}
</dl>
<h3>Step marks</h3>
{{- with .Steps}}
{{- if .MarksWhy}}
<p class="why">{{.MarksWhy}}</p>
{{- else}}
<p class="note">{{.MarksNote}}</p>
<div class="scroll">
<table>
<thead><tr><th>Mark</th><th>The guest's name</th><th>At (guest)</th><th>GitHub step</th><th>Started (GitHub)</th><th>Mark minus GitHub</th></tr></thead>
<tbody>
{{- range .Marks}}
<tr><th scope="row">{{.Mark}}</th><td>{{.Name}}</td><td>{{.At}}</td><td>{{.Step}}</td><td>{{.GitHub}}</td><td>{{.Offset}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}
<h3>Processes by step</h3>
{{- if .ProcsWhy}}
<p class="why">{{.ProcsWhy}}</p>
{{- else}}
<p class="note">{{.ProcsNote}}</p>
<div class="scroll">
<table>
<thead><tr><th>Process</th><th>Most at once</th><th>CPU</th><th>Peak RSS</th><th>Read</th><th>Written</th></tr></thead>
{{- range .Procs}}
<tbody>
<tr class="group"><th scope="rowgroup" colspan="6">{{.Label}}{{with .Name}} {{.}}{{end}}: {{.Samples}}</th></tr>
{{- range .Rows}}
<tr><th scope="row">{{.Name}}</th><td>{{.Procs}}</td><td>{{.CPU}}</td><td>{{.RSS}}</td><td>{{.Read}}</td><td>{{.Written}}</td></tr>
{{- end}}
{{- with .Rest}}
<tr class="qualifier"><td colspan="6">{{.}}</td></tr>
{{- end}}
{{- with .Exited}}
<tr class="qualifier"><td colspan="6">{{.}}</td></tr>
{{- end}}
</tbody>
{{- end}}
</table>
</div>
{{- end}}
{{- end}}
<h3>Test results</h3>
{{- with .Tests}}
{{- with .Why}}
<p class="why">{{.}}</p>
{{- end}}
{{- if .Suites}}
<div class="scroll">
<table>
<thead><tr><th>Suite</th><th>Tests</th><th>Failures</th><th>Errors</th><th>Skipped</th><th>Failed</th></tr></thead>
<tbody>
{{- range .Suites}}
<tr><th scope="row">{{.Name}}</th><td>{{.Tests}}</td><td>{{.Failures}}</td><td>{{.Errors}}</td><td>{{.Skipped}}</td><td>{{range $i, $n := .Failed}}{{if $i}}, {{end}}{{$n}}{{end}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}
{{- with .Dropped}}
<p class="note">{{.}}</p>
{{- end}}
{{- end}}
{{- end}}
{{- end}}
</section>

<footer>Rendered by <code>billet jobs show --html</code> from the ledger and GitHub's record of the run. Read-only: the page fetches nothing.</footer>
{{- end}}
<script>{{.Script}}</script>
</body>
</html>
