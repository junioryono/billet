      "Remove-Item -Recurse 'C:\\image\\toolsets'"
    ]
  },
  {
    "id": "shell:d1956e4c44c4",
    "kind": "windows-shell",
    "inline": [
      "net user installer @install_password@ /add /passwordchg:no /passwordreq:yes /active:yes /Y",
      "net localgroup Administrators installer /add",
      "winrm set winrm/config/service/auth @{Basic=\"true\"}",
      "winrm get winrm/config/service/auth"
    ]
  },
  {
    "id": "inline:66fcb42eef59",
