# The cloudflared connector, rendered by the junioryono.billet.cloudflared_connector
# role. Byte for byte what `cloudflared service install` writes (measured on
# cloudflared 2026.7.3), so a host the installer set up converges to changed=0;
# rendered here rather than installed, because the installer takes the token
# only in argv and this role never puts a credential there.
[Unit]
Description=Cloudflare Tunnel client
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart={{ billet_cloudflared_binary }} --no-autoupdate tunnel run --token-file {{ billet_cloudflared_config_dir }}/token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
