# Managed by junioryono.billet.host. Disable billet_alert_email to remove this file.
defaults
auth on
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /var/log/msmtp.log

account default
host {{ billet_smtp_host }}
port {{ billet_smtp_port }}
from {{ billet_alert_from }}
user {{ billet_smtp_username }}
password {{ billet_smtp_password }}
