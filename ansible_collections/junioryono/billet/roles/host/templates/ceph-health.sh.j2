#!/bin/sh
set -eu

# ONE EMAIL PER PROBLEM, AND ONLY FOR A PROBLEM. An email is sent when a Ceph
# health check appears that has not been seen since health was last OK, and for
# nothing else: not when ceph's counts or percentages move, not when a check
# clears or gives way to a milder one (backfillfull back to nearfull), and not on
# recovery. Comparing the detail text sent three emails for one nearfull episode
# on 2026-10-03. The checks seen since the last HEALTH_OK are the state; OK
# clears it.

state_dir=/var/lib/billet/health
state_file=${state_dir}/ceph.last
mkdir -p "${state_dir}"

detail=$(ceph health detail 2>&1) || status=ERROR
status=${status:-$(printf '%s\n' "${detail}" | sed -n '1s/ .*//p')}
# A symlink is never read: its target may be an archived secret.
previous=$(test -f "${state_file}" && ! test -L "${state_file}" && cat "${state_file}" || true)

# The check names a detail lists ("[WRN] OSD_NEARFULL: ..."), one per line. A
# state written before this version holds the detail itself, so it is read the
# same way and a converge never re-sends what was already sent.
checks() {
    printf '%s\n' "$1" | sed -nE 's/^\[(WRN|ERR)\] ([A-Z0-9_]+):.*/\2/p'
}

seen=$(checks "${previous}"; printf '%s\n' "${previous}" | grep -E '^[A-Z0-9_]+$' || true)

case "${status}" in
HEALTH_OK)
    now=""
    ;;
ERROR)
    now=CEPH_UNREADABLE
    ;;
*)
    now=$(checks "${detail}")
    # A status with no check named is still a problem, under its own name.
    if [ -z "${now}" ]; then
        now=${status}
    fi
    ;;
esac

new=""
for check in ${now}; do
    if ! printf '%s\n' "${seen}" | grep -qxF -- "${check}"; then
        new="${new} ${check}"
    fi
done

if [ -n "${new}" ]; then
    printf '%s\n' "${detail}" | mail -r {{ billet_alert_from | quote }} -s "billet Ceph health on $(hostname): ${status}:${new}" {{ billet_alert_email | quote }}
fi

if [ "${status}" = "HEALTH_OK" ]; then
    record=""
else
    record=$(printf '%s\n%s\n' "${seen}" "${now}" | grep -E '^[A-Z0-9_]+$' | sort -u || true)
fi

# Rename replaces a planted ceph.last symlink instead of opening its target;
# -T keeps a symlink to a directory from receiving the file inside it.
state_tmp=$(mktemp "${state_dir}/.ceph.last.XXXXXXXX")
trap 'rm -f "${state_tmp}"' EXIT HUP INT TERM
printf '%s\n' "${record}" >"${state_tmp}"
mv -fT -- "${state_tmp}" "${state_file}"
trap - EXIT HUP INT TERM
