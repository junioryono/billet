# billet control plane environment — rendered by the junioryono.billet.host role.
#
# THIS FILE HOLDS CREDENTIALS. It is 0640 root:{{ billet_service_group }} and is read by
# billet-server.service through EnvironmentFile=. `billet local backup` does not
# archive it: it is not part of the deployment identity, and the value in it
# belongs to whatever provisioned the database.
#
# systemd's EnvironmentFile parses NAME=value one per line and performs no shell
# expansion, so the value is written verbatim.
{% for name in billet_server_environment | sort %}
{{ name }}={{ billet_server_environment[name] }}
{% endfor %}
