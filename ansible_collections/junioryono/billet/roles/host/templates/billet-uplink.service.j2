[Unit]
Description=billet keeps this host's traffic from filling its site's shared internet line
Documentation=https://billet.readthedocs.io/en/latest/reference/cli.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/billet uplink shape
ExecStopPost=/usr/bin/billet uplink clear
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
