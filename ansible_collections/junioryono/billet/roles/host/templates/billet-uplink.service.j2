[Unit]
Description=billet keeps this host's traffic from filling its site's shared internet line
Documentation=https://billet.readthedocs.io/en/latest/reference/cli.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/billet uplink shape{% if billet_uplink_max_up_mbit | int > 0 %} --max-up {{ billet_uplink_max_up_mbit | int }}{% endif %}{% if billet_uplink_max_down_mbit | int > 0 %} --max-down {{ billet_uplink_max_down_mbit | int }}{% endif %}

ExecStopPost=/usr/bin/billet uplink clear
# The interface the shaper chose, kept past a stop so the cleanup above finds
# it; a reboot empties it along with the shaping.
RuntimeDirectory=billet-uplink
RuntimeDirectoryPreserve=yes
# The rates the shaper learned and where it found the line full, which the next
# run resumes as they were, after a restart or a reboot alike.
StateDirectory=billet-uplink
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
