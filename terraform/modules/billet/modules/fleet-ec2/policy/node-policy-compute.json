{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BilletRuntimeRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletRuntimeLaunch",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "BilletRuntimeDenyForeignSnapshot",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:TFPARTITION:ec2:*:*:snapshot/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "true"
        }
      }
    },
    {
      "Sid": "BilletRuntimeTag",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSnapshot"
          ]
        }
      }
    },
    {
      "Sid": "BilletRuntimeTerminate",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/sh.billet.owner": "false"
        }
      }
    }
  ]
}
