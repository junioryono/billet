{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BilletBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:TFPARTITION:s3:::TFBUCKET/TFPREFIX/*"
      ]
    },
    {
      "Sid": "BilletBackupList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:TFPARTITION:s3:::TFBUCKET"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "TFPREFIX/*"
          ]
        }
      }
    }
  ]
}
