{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BilletBuildReadRegistration",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:TFPARTITION:ssm:TFREGION:TFACCOUNT:parameter/TFPARAMPATH/*"
      ]
    },
    {
      "Sid": "BilletBuildLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:TFPARTITION:logs:TFREGION:TFACCOUNT:log-group:TFLOGGROUP:*"
      ]
    }
  ]
}
